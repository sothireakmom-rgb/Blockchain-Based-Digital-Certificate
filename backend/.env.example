# --- Server ---
PORT=4000

# --- Database (Supabase Postgres) ---
# Pooled connection (transaction pooler, port 6543) used by the app at runtime.
DATABASE_URL=
# Direct connection (port 5432) used by `prisma migrate`.
DIRECT_URL=

# --- Auth ---
JWT_SECRET=

# --- Blockchain ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Email (Resend) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Optional. Defaults to Resend's shared sender, which ONLY delivers to the
# email that owns the Resend account until you verify your own domain.
RESEND_FROM=
